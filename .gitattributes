# Enforce LF line endings for all text files
* text=auto eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.apk binary
*.aab binary
*.jar binary
*.keystore binary
*.jks binary
