{
  "name": "servio-backend",
  "version": "1.0.0",
  "description": "SERVIO — AI-powered home maintenance & services marketplace REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "migrate:escrow": "node src/migrations/2026-05-19-escrow-cashdebt.js",
    "migrate:wallet-reconcile": "node src/migrations/2026-05-28-reconcile-worker-wallets.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "clearMocks": true,
    "testTimeout": 60000
  },
  "keywords": [
    "servio",
    "marketplace",
    "rest-api",
    "nodejs"
  ],
  "author": "SERVIO Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.3.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nanoid": "^3.3.12",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.6",
    "pdfkit": "^0.15.2",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
